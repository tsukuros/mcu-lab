# PlatformIO
.pio/
# Ignore every .vscode at any depth (PlatformIO generates per-project ones
# full of absolute paths), but keep the repo-root settings.json, which
# carries the format-on-save wiring for .clang-format.
**/.vscode/*
!/.vscode/settings.json

# ESP-IDF: version only sdkconfig.defaults; the rest is generated.
sdkconfig
sdkconfig.*
!sdkconfig.defaults
build/

*.bin
*.elf
*.map

docs/html/

# clangd: absolute paths for this machine only.
compile_commands.json
.clangd
.cache/

.DS_Store
